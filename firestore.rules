rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /members/{memberId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == memberId);
      allow list: if isOwner();

      // Members may create only their own basic profile during signup.
      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email;

      // Only the gym owner can change fees, expiry dates, or member details.
      allow update, delete: if isOwner();

      match /payments/{paymentId} {
        allow read: if isOwner() || (signedIn() && request.auth.uid == memberId);
        allow create, update, delete: if isOwner();
      }
    }
  }
}